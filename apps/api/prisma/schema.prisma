generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CLIENT
}

enum VmStatus {
  ON
  OFF
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())
}

model Vm {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  nameKey   String   @unique
  cores     Int
  ram       Int
  disk      Int
  os        String
  status    VmStatus
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
