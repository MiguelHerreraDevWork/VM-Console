{
  "name": "@repo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "build": "pnpm db:generate && tsc -p tsconfig.build.json",
    "start": "node --env-file=../../.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "node --env-file=../../.env ./node_modules/vitest/vitest.mjs run",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "pnpm db:generate && node --env-file=../../.env ./node_modules/prisma/build/index.js migrate deploy",
    "db:migrate:dev": "node --env-file=../../.env ./node_modules/prisma/build/index.js migrate dev",
    "db:seed": "tsx --env-file=../../.env prisma/seed.ts",
    "db:reset": "node --env-file=../../.env ./node_modules/prisma/build/index.js migrate reset --force",
    "db:test:migrate": "tsx --env-file=../../.env scripts/migrate-test-db.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/jwt": "^10.2.5",
    "@fastify/rate-limit": "^11.2.1",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^6.16.3",
    "@repo/contracts": "workspace:*",
    "fastify": "^5.6.1",
    "fastify-plugin": "^6.0.1",
    "socket.io": "^4.8.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.18.8",
    "prisma": "^6.16.3",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "prisma": {
    "seed": "tsx --env-file=../../.env prisma/seed.ts"
  }
}
