# PostgreSQL (Docker Compose)
POSTGRES_USER=ifx
POSTGRES_PASSWORD=ifx_dev_password
POSTGRES_DB=ifx
POSTGRES_PORT=5432

# Prisma — development and isolated test database (same container)
DATABASE_URL=postgresql://ifx:ifx_dev_password@localhost:5432/ifx?schema=public
DATABASE_URL_TEST=postgresql://ifx:ifx_dev_password@localhost:5432/ifx_test?schema=public

# API
API_PORT=4000
API_INTERNAL_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000
# Browser → Socket.IO (direct; Next rewrites do not proxy WebSocket /socket.io)
NEXT_PUBLIC_API_URL=http://localhost:4000

# JWT (consumed in phase 02; required at API boot)
JWT_SECRET=dev-only-change-me-to-a-long-secret-32+
JWT_EXPIRES_IN=8h

# Seed credentials (local demo only)
SEED_ADMIN_EMAIL=admin@demo.local
SEED_ADMIN_PASSWORD=AdminDemo!234
SEED_CLIENT_EMAIL=cliente@demo.local
SEED_CLIENT_PASSWORD=ClienteDemo!234
